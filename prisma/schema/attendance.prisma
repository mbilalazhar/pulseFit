model Attendance {
  id             String   @id @default(cuid())
  gymId          String
  memberId       String
  attendanceDate DateTime @db.Date
  checkInAt      DateTime @default(now())
  checkOutAt     DateTime?
  durationMinutes Int?                      // [NEW] set on check-out; drives heatmap intensity
  note            String?                   // [NEW] "session notes"

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId, gymId], references: [id, gymId])

  @@unique([memberId, attendanceDate])
  @@index([gymId, attendanceDate])
}
