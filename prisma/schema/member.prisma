enum MemberStatus {
  ACTIVE
  INACTIVE
  FROZEN
}

model Member {
  id        String       @id @default(cuid())
  gymId     String
  userId    String?      @unique
  name      String
  phone     String
  email     String?
  status    MemberStatus @default(INACTIVE)
  joinedAt  DateTime     @default(now())
  createdAt DateTime     @default(now())
  deletedAt DateTime?

  // [CHANGED] REMOVED planId, startDate, durationMonths, trainerId.
  // They duplicated MemberSubscription / assignment data and could drift out of sync.
  // Current plan  = the member's ACTIVE MemberSubscription.
  // Current trainer = the member's open MemberTrainerAssignment (endedAt IS NULL).


  gym               Gym                  @relation(fields: [gymId], references: [id])
  user              User?                @relation(fields: [userId], references: [id])
  subscriptions     MemberSubscription[]
  payments          Payment[]
  attendance        Attendance[]
  assignments       MemberTrainerAssignment[]
  trainingSessions  TrainingSession[]
  measurements      BodyMeasurement[]
  goals             MemberGoal[]
  notes             MemberNote[]

  @@unique([gymId, email])
  @@unique([id, gymId])
  @@index([gymId, status, joinedAt])
  @@index([gymId, phone])
}

model BodyMeasurement {
  id           String   @id @default(cuid())
  gymId        String
  memberId     String
  measuredAt   DateTime
  weightKg     Decimal? @db.Decimal(5, 2)
  bodyFatPct   Decimal? @db.Decimal(4, 1)
  muscleMassKg Decimal? @db.Decimal(5, 2)

  member Member @relation(fields: [memberId, gymId], references: [id, gymId])
}

enum GoalType {
  FAT_LOSS
  LEAN_MUSCLE
  ENDURANCE
  CONSISTENCY
  CUSTOM
}

model MemberGoal {
  id          String    @id @default(cuid())
  gymId       String
  memberId    String
  type        GoalType
  description String?
  achievedAt  DateTime?
  member      Member    @relation(fields: [memberId, gymId], references: [id, gymId])
  @@index([memberId])
}

model MemberNote {
  id           String   @id @default(cuid())
  gymId        String
  memberId     String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())
  member       Member   @relation(fields: [memberId, gymId], references: [id, gymId])
  @@index([memberId, createdAt])
}
