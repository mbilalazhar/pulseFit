enum Role {
  ADMIN
  MANAGER
  TRAINER
  MEMBER
}

model User {
  id       String @id @default(cuid())
  gymId    String
  email    String @unique
  password String
  role     Role

  gym      Gym     @relation(fields: [gymId], references: [id])
  member   Member?
  trainer  Trainer?

  @@index([gymId, role])
}
