enum Tier {
  BASIC
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model GymSubscription {
  id          String             @id @default(cuid())
  gymId       String
  tier        Tier
  memberLimit Int
  priceMinor  Int
  status      SubscriptionStatus @default(TRIAL)
  startDate   DateTime           @default(now())
  endDate     DateTime

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId, status])
}
