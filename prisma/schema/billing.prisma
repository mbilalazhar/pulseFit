enum MemberSubStatus {
  INACTIVE
  ACTIVE
  EXPIRED
  CANCELLED
}
enum MemberPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model MemberSubscription {
  id         String          @id @default(cuid())
  gymId      String
  memberId   String
  planId     String
  planNameSnapshot String                                    // [NEW] survives plan rename/delete
  durationMonths Int                                         // [NEW] moved here from Member
  sessionsPerWeek Int?
  sessionDurationMinutes Int?
  priceMinor Int
  discountMinor Int @default(0)
  additionalChargeMinor Int @default(0)
  finalMinor     Int                                         // priceMinor + additionalChargeMinor - discountMinor
  currency String @default("PKR")
  startDate  DateTime
  endDate    DateTime
  status     MemberSubStatus @default(ACTIVE)
  paymentStatus  MemberPaymentStatus @default(UNPAID)        // [NEW]
  paymentDueDate DateTime?           @db.Date                // [NEW] powers "outstanding / overdue"
  createdAt  DateTime        @default(now())

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId, gymId], references: [id, gymId])
  plan   Plan   @relation(fields: [planId, gymId], references: [id, gymId])
  payments  Payment[]

  @@unique([id, gymId])
  @@index([gymId, status, endDate])
  @@index([gymId, paymentStatus, paymentDueDate])
  @@index([memberId, status])
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PaymentKind {
  PAYMENT
  REFUND
}

model Payment {
  id          String   @id @default(cuid())
  gymId       String
  memberId    String
  memberSubscriptionId String                                 // [NEW] required link to what was paid for
  kind        PaymentKind   @default(PAYMENT)
  amountMinor Int
  currency    String  @default("PKR")
  method      PaymentMethod
  reference            String?                                // [NEW] receipt/txn no.
  recordedByUserId     String?                                // [NEW] who entered it
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId, gymId], references: [id, gymId])
  subscription MemberSubscription @relation(fields: [memberSubscriptionId, gymId], references: [id, gymId])

  @@index([gymId, paidAt])
  @@index([gymId, memberId, paidAt])
  @@index([memberSubscriptionId])
}
